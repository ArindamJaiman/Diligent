<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates from GitHub releases; Android still asks before installing -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nothing Phone (3) Glyph Matrix (used only when the Glyph SDK is bundled, docs/GLYPH.md) -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <!-- Look & feel: app lock and haptics -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- QuotaPulse live mode: user-started foreground service (dataSync) -->
    <!-- Focus timer as an Android 16 Live Update (status-bar chip) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Today's Top 3: busy time from the phone's calendars (read locally, asked at runtime) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Focus → calendar log: finished sessions as events in a calendar you pick (optional) -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Focus → Do Not Disturb while a session runs (access granted in system settings) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Screen vs Focus: per-app screen time, granted by the user in Usage access settings -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Health → Gym: read exercise sessions from Health Connect -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Health → sleep, steps and mindfulness for the day log (each optional, asked at runtime) -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" />
    <!-- Automations: write diligent:// links to NFC tags -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Automations → places: geofences ("arrive at the gym → start the timer"), asked at runtime -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:name=".DiligentApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Diligent"
        tools:targetApi="35">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Diligent">
            <!-- The launcher entry lives on the aliases below, so Settings can swap the icon -->
            <!-- Long-press on the focus Quick Settings tile opens the app -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Buttons on activity reminders (log, start timer, done, snooze); not exported -->
        <receiver
            android:name=".notifications.ReminderActionReceiver"
            android:exported="false" />

        <!-- Launcher icons (Settings → Look & feel → Icon); exactly one is enabled -->
        <activity-alias
            android:name="dev.diligent.app.LauncherClassic"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.diligent.app.LauncherDots"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dots"
            android:roundIcon="@mipmap/ic_launcher_dots"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.diligent.app.LauncherRing"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ring"
            android:roundIcon="@mipmap/ic_launcher_ring"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.diligent.app.LauncherPaper"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_paper"
            android:roundIcon="@mipmap/ic_launcher_paper"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Install results for in-app updates; only the system reaches it, via our PendingIntent -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Widget Provider -->
        <receiver
            android:name=".widget.DiligentWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/diligent_widget_info" />
        </receiver>

        <!-- GitHub Slideshow Widget -->
        <receiver
            android:name=".widget.GithubWidgetReceiver"
            android:exported="true"
            android:label="GitHub Dev Tracker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/github_widget_info" />
        </receiver>

        <!-- GitHub Versus Mode Widget -->
        <receiver
            android:name=".widget.GithubVsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_github_vs_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/github_vs_widget_info" />
        </receiver>

        <!-- QuotaPulse AI usage widget -->
        <receiver
            android:name=".quotapulse.widget.QuotaPulseWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quotapulse_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quotapulse_widget_info" />
        </receiver>

        <!-- QuotaPulse STOP LIVE + redraw-only refresh (not exported) -->
        <receiver
            android:name=".quotapulse.live.QuotaPulseControlReceiver"
            android:exported="false" />

        <!-- QuotaPulse live monitoring, started only by an explicit user tap -->
        <service
            android:name=".quotapulse.live.LiveMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- LeetCode tracker widget -->
        <receiver
            android:name=".leetcode.widget.LeetCodeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_leetcode_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/leetcode_widget_info" />
        </receiver>

        <!-- LeetCode contest alarms, notification buttons, widget redraw (not exported) -->
        <receiver
            android:name=".leetcode.notify.LeetCodeReceiver"
            android:exported="false" />

        <!-- Invisible hop from a widget tap to a leetcode.com link -->
        <activity
            android:name=".leetcode.widget.LeetCodeLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Focus timer widget -->
        <receiver
            android:name=".focus.widget.FocusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_focus_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_widget_info" />
        </receiver>

        <!-- Focus timer STOP button and Pomodoro block alarm (not exported) -->
        <receiver
            android:name=".focus.notify.FocusReceiver"
            android:exported="false" />

        <!-- Focus timer Quick Settings tile. Active tile: bound only when the timer changes or on tap -->
        <service
            android:name=".focus.tile.FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_focus_timer"
            android:label="@string/tile_focus_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Midnight widget refresh (non-wakeup alarm, see DayChangeRefresh) -->
        <receiver
            android:name=".widget.DayChangeReceiver"
            android:exported="false" />

        <!-- WorkManager Initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- ─── Productivity tools (Hub) ─────────────────────────── -->

        <receiver
            android:name=".contests.ContestWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_contests_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/contests_widget_info" />
        </receiver>

        <receiver
            android:name=".versus.VersusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_versus_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/versus_widget_info" />
        </receiver>

        <receiver
            android:name=".papers.PaperWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_papers_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/papers_widget_info" />
        </receiver>

        <receiver
            android:name=".top3.Top3WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_top3_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/top3_widget_info" />
        </receiver>

        <receiver
            android:name=".screentime.ScreenTimeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_screentime_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/screentime_widget_info" />
        </receiver>

        <!-- Contest heads-up alarms and tool widget redraws (not exported) -->
        <receiver
            android:name=".tools.ToolsReceiver"
            android:exported="false" />

        <!-- Invisible hop from a tool widget tap to arXiv / contest pages -->
        <activity
            android:name=".tools.ToolLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Weekly review image sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.tools.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/tool_file_paths" />
        </provider>

        <!-- diligent://log|set|done|skip|focus from NFC tags, shortcuts and Tasker (off until
             Hub → Automations → "Allow outside commands") -->
        <activity
            android:name=".automation.CommandActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="diligent" />
                <data android:host="log" />
                <data android:host="set" />
                <data android:host="done" />
                <data android:host="skip" />
                <data android:host="focus" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="diligent" />
            </intent-filter>
        </activity>

        <!-- Tasker / automation apps: broadcast dev.diligent.app.action.COMMAND (same gate) -->
        <receiver
            android:name=".automation.CommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.diligent.app.action.COMMAND" />
            </intent-filter>
        </receiver>

        <!-- Geofence transitions from Play services' PendingIntent -->
        <receiver
            android:name=".automation.PlaceTriggerReceiver"
            android:exported="false" />

        <!-- Wear OS tile's + buttons arrive here (wear module, same applicationId) -->
        <service
            android:name=".wear.WearListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/diligent"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- "Now" widget: the card that fits the moment (timer, Top 3, next block, shutdown) -->
        <receiver
            android:name=".now.NowWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_now_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_widget_info" />
        </receiver>

        <!-- Glyph Toy for the Nothing Phone (3) back matrix: focus ring, goals done, streak -->
        <service
            android:name=".glyph.GlyphToyService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:value="Diligent" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/ic_launcher_ring_foreground" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:value="Focus timer ring, goals done today; long press for your best streak" />
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
        </service>

        <!-- Quick log: type or say "2h quantum"; opened from the tile, shortcuts and the dashboard -->
        <activity
            android:name=".quicklog.QuickLogActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.diligent.app.quicklog"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Launcher "Focus: …" shortcuts; acts only on intents with this install's token -->
        <activity
            android:name=".quicklog.ShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".quicklog.QuickLogTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_quicklog_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Desk mode and the same face as a screen saver (StandBy-style while charging) -->
        <activity
            android:name=".desk.DeskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Diligent" />

        <service
            android:name=".desk.DeskDreamService"
            android:exported="true"
            android:label="@string/desk_dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Focus Shield: notices which app opens (window changes only) to cover distracting ones -->
        <service
            android:name=".focus.shield.ShieldService"
            android:exported="false"
            android:label="@string/shield_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shield_service" />
        </service>

        <!-- Covers a blocked app / the mindful pause; its own task so Back can't land in the app -->
        <activity
            android:name=".focus.shield.ShieldActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="dev.diligent.app.shield"
            android:theme="@style/Theme.Diligent" />

        <!-- Health Connect: privacy explanation shown from its permission screen -->
        <activity
            android:name=".health.HealthPrivacyActivity"
            android:exported="true"
            android:theme="@style/Theme.Diligent">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.HealthPrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

    <!-- Health Connect app (Android 13 and older) and launcher detection for screen time -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Automations: pick which apps' time counts towards an activity -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
