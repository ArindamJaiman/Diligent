<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QuotaPulse live mode: user-started foreground service (dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".DiligentApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Diligent"
        tools:targetApi="35">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Diligent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget Provider -->
        <receiver
            android:name=".widget.DiligentWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/diligent_widget_info" />
        </receiver>

        <!-- GitHub Slideshow Widget -->
        <receiver
            android:name=".widget.GithubWidgetReceiver"
            android:exported="true"
            android:label="GitHub Dev Tracker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/github_widget_info" />
        </receiver>

        <!-- GitHub Versus Mode Widget -->
        <receiver
            android:name=".widget.GithubVsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_github_vs_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/github_vs_widget_info" />
        </receiver>

        <!-- QuotaPulse AI usage widget -->
        <receiver
            android:name=".quotapulse.widget.QuotaPulseWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quotapulse_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quotapulse_widget_info" />
        </receiver>

        <!-- QuotaPulse STOP LIVE + redraw-only refresh (not exported) -->
        <receiver
            android:name=".quotapulse.live.QuotaPulseControlReceiver"
            android:exported="false" />

        <!-- QuotaPulse live monitoring, started only by an explicit user tap -->
        <service
            android:name=".quotapulse.live.LiveMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- LeetCode tracker widget -->
        <receiver
            android:name=".leetcode.widget.LeetCodeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_leetcode_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/leetcode_widget_info" />
        </receiver>

        <!-- LeetCode contest alarms, notification buttons, widget redraw (not exported) -->
        <receiver
            android:name=".leetcode.notify.LeetCodeReceiver"
            android:exported="false" />

        <!-- Invisible hop from a widget tap to a leetcode.com link -->
        <activity
            android:name=".leetcode.widget.LeetCodeLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Midnight widget refresh (non-wakeup alarm, see DayChangeRefresh) -->
        <receiver
            android:name=".widget.DayChangeReceiver"
            android:exported="false" />

        <!-- WorkManager Initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
