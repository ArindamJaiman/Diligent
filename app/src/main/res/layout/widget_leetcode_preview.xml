<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview and initial layout for the LeetCode tracker (no live data). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20A0A0A"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="LEETCODE  ●"
        android:textColor="#FFFFA116"
        android:textSize="9sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="#FF1E1E1E" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="STREAK        EASY  MED  HARD"
        android:textColor="#FF8C8C8C"
        android:textSize="8sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="DAILY CHALLENGE · TAP SYNC TO LOAD"
        android:textColor="#FF5A5A5A"
        android:textSize="7sp" />
</LinearLayout>
