<?xml version="1.0" encoding="utf-8"?>
<!-- One developer slide inside widget_github_flipper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header: tap to jump to the next developer -->
    <LinearLayout
        android:id="@+id/slide_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/slide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/slide_rotate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:paddingStart="4dp"
            android:text="↺"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/slide_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF222222" />

    <!-- Body: tap to open the app -->
    <LinearLayout
        android:id="@+id/slide_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/slide_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Contribution calendar"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/slide_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="#FF888888"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/slide_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/slide_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="#FF666666"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/slide_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#FF444444"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
