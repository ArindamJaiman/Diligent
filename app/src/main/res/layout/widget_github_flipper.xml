<?xml version="1.0" encoding="utf-8"?>
<!-- Developer slideshow for the GitHub widget. The launcher flips the slides itself,
     so auto-rotation costs the app no wakeups and pauses whenever the home screen
     is not visible. -->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/github_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:flipInterval="10000"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out" />
