<?xml version="1.0" encoding="utf-8"?>
<!-- Animated ticker-tape panel for the Diligent widget using ViewFlipper.
     Provides smooth sliding text animations fully supported in RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ticker_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF000000"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <!-- Hero ViewFlipper: slides between punchy phrases -->
    <ViewFlipper
        android:id="@+id/hero_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoStart="true"
        android:flipInterval="3000"
        android:inAnimation="@android:anim/slide_in_left"
        android:outAnimation="@android:anim/slide_out_right">

        <TextView
            android:id="@+id/hero_text_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FF4ADE80"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/hero_text_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FF4ADE80"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/hero_text_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FF4ADE80"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/hero_text_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FF4ADE80"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </ViewFlipper>

    <!-- Ticker-tape separator line -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF1E1E1E"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Quotes ViewFlipper: slides between quotes + author attribution -->
    <ViewFlipper
        android:id="@+id/quote_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoStart="true"
        android:flipInterval="6000"
        android:inAnimation="@android:anim/slide_in_left"
        android:outAnimation="@android:anim/slide_out_right">

        <!-- Slide 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/quote_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFB0B0B0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="4" />
            <TextView
                android:id="@+id/quote_author_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5A5A5A"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:paddingEnd="6dp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Slide 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/quote_text_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFB0B0B0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="4" />
            <TextView
                android:id="@+id/quote_author_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5A5A5A"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:paddingEnd="6dp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Slide 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/quote_text_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFB0B0B0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="4" />
            <TextView
                android:id="@+id/quote_author_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5A5A5A"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:paddingEnd="6dp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </ViewFlipper>

</LinearLayout>
