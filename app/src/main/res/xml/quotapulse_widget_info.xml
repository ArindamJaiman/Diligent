<?xml version="1.0" encoding="utf-8"?>
<!-- QuotaPulse: periodic updates are disabled (updatePeriodMillis=0). The widget redraws
     only after a sync, a live-mode change, or when cached data turns stale. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="100dp"
    android:maxResizeWidth="560dp"
    android:maxResizeHeight="520dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quotapulse_preview"
    android:previewLayout="@layout/widget_quotapulse_preview"
    android:description="@string/widget_quotapulse_description" />
